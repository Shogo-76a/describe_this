<!-- ヘッダーの内容変更 -->
<% provide(:sign_up) do %>
    <div class="flex items-end gap-0">
        <p class="text-2xl font-normal opacity-75">ログイン</p>
    </div>
<% end %>


<div class="min-h-[calc(100vh-15rem)] flex flex-col justify-center items-center max-w-sm mx-auto mt-10">
  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg inline-block" id="alert"><%= alert %></p>
  <% end %>
  <% if notice = flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <%= form_with url: session_url, class: "flex flex-col items-center justify-center gap-3" do |form| %>
    <div class="w-full">
      <%= form.label :email_address, "メールアドレス" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username", value: params[:email_address], 
      class: "mt-1 items-center justify-center input input-bordered rounded-full w-full" %>
    </div>

    <div class="w-full">
      <%= form.label :password, "パスワード" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "mt-1 items-center justify-center input input-bordered rounded-full w-full" %>
    </div>

    <%= form.submit "ログイン", class: "btn btn-primary btn-text-primary w-40 rounded-full" %>

    <div class="mt-4 text-sm text-gray-500 sm:mt-0">
      <%= link_to "パスワードを忘れた場合", new_password_path, class: "text-base-content/50 underline hover:no-underline" %>
    </div>

    <div class="w-full my-2 divider">
        <p class="w-50 text-sm text-center text-base-content/50">
          または
        </p>
    </div>

    <div class="flex flex-row gap-5">
      <div class="border-1 rounded-2xl w-10 h-10 text-center">
        <p>G</p>
      </div>

      <div class="border-1 rounded-2xl w-10 h-10 text-center">
        <p>X</p>
      </div>

      <div class="border-1 rounded-2xl w-10 h-10 text-center">
        <p>LINE</p>
      </div>
    </div>

    <div class="py-2">
      <p class="pb-2 w-full text-sm text-center text-base-content/50">
        ご登録がまだの方はこちら：<%=link_to "新規登録", registrations_new_path, method: :get, class: "border-1 border-primary rounded-2xl px-2 font-bold text-primary" %>
      </p>
    </div>
  <% end %>
</div>
