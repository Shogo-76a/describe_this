<!-- ヘッダーの内容変更 -->
<% provide(:sign_up) do %>
    <div class="flex flex-col justify-center items-center w-60 landscape:w-100 mx-auto">
        <!-- ボタン無しフォーム -->
        <%= form_with url: user_games_path(current_user),
            method: :get,
            local: true,
            class: "flex flex-col justify-center items-center w-full h-auto" do |f| %>
            <%= f.text_field :query,
                value: @query,
                placeholder: "🔍ワード検索", 
                class: "flex flex-col justify-center items-center w-full h-auto textarea textarea-bordered resize-none min-h-[40px] h-[40px] rounded-2xl"%>
        <% end %>
    </div>
<% end %>

<% if @games.present? %>
<div class="flex flex-col justify-center items-center max-w-sm landscape:max-w-xl mx-auto py-10">
    <div class="flex flex-col w-full h-auto mx-auto gap-5">
        <%= render partial: "shared/history_bar", collection: @games, as: :game %>
    </div>
</div>
<% else %>
    <div class="min-h-[calc(100vh-15rem)] flex flex-col justify-center items-center max-w-sm mx-auto mt-10">
        <div class="flex flex-col text-base-content/50 max-w-xs landscape:max-w-3xl mx-auto">
            <p class="text-lg">プレイ履歴がありません。</p>

        </div>
    </div>
<% end %>
