<!-- ヘッダーの内容変更 -->
<% provide(:in_game) do %>
    <div class="flex items-end gap-0">
        <p class="text-2xl font-normal opacity-75"><!-- 空欄 --></p>
    </div>
<% end %>
<div 
  data-controller="generated-image-polling transcription"
  data-generated-image-polling-url-value="<%= check_generated_image_user_game_path(@game) %>"
  data-generated-image-polling-max-attempts-value="300"
  data-generated-image-polling-interval-value="2000"
  class="bg-base-300 min-h-full flex flex-col pt-0 z-10"
>
    <div data-controller="collapsible-image" class="relative bg-base-200 p-4 flex flex-col landscape:hero">
        <div data-collapsible-image-target="wrapperGlobal"        
            class="w-full aspect-[600/400] overflow-hidden 
                landscape:flex landscape:flex-row landscape:gap-4 landscape:max-w-5xl">

            <div data-collapsible-image-target="wrapperA"
                data-action="click->collapsible-image#toggle"
                class="absolute top-0 left-0 h-full landscape:h-auto w-1/2 transition-all duration-500 ease-in-out
                    landscape:h-auto">

                <div class="w-full h-full landscape:h-auto">
                    <img
                        id="theme-image-imgtag"
                        src="<%= @game.theme_image_url %>"
                        alt="<%= t('img_src.theme') %>"
                        class="w-full h-full landscape:h-auto object-cover object-left rounded-4xl">
                </div>
            </div>
            
            <div data-collapsible-image-target="wrapperB"
                data-action="click->collapsible-image#toggle"
                class="absolute top-0 right-0 h-full landscape:h-auto w-1/2 transition-all duration-500 ease-in-out
                    landscape:h-auto">

                <div id="generated-image" class="w-full h-full landscape:h-auto">
                    <div class="w-full h-full landscape:h-auto object-cover object-right aspect-[600/400] bg-base-100 rounded-4xl"></div>
                </div>
            </div>
        </div>
        
        <div id="scoring_button", class="flex justify-center mt-5">
            <p class="btn btn-lg bg-neutral/50 text-neutral-content/50 font-normal text-sm w-70 h-12 rounded-2xl">
                <%= t('.instruction_html') %>
            </p>
        </div>

        <!-- テキスト入力欄 -->
        <div class="max-w-2xl mx-auto w-full mt-5">
            <%= form_with(url: user_game_path(@game.user_id, @game), model: @game, 
                data: { 
                    controller: "chat-form", 
                    chat_form_limit_value: @message_limit, 
                    action: "
                            submit->chat-form#validateForm 
                            keydown->chat-form#handleKeydown 
                            turbo:submit-end->chat-form#clear
                            " 
                }) do |f| %>

                <div class="flex gap-2 items-end">
                    <%= f.text_area :description, 
                        id: "transcript_id",
                        data: { 
                            transcription_target: "transcript",
                            chat_form_target: "textarea", 
                            action: "input->chat-form#resize"
                        },
                        rows: 1,
                        class: "textarea textarea-bordered w-full resize-none py-2 min-h-[40px] h-[40px]", 
                        placeholder: t('.chat_placeholder') %>
                    <div class="tooltip tooltip-open tooltip-primary">
                        <div class="tooltip-content bg-transparent shadow-none">
                            <div class="text-sm flex flex-col justify-center items-center text-primary font-bold">
                                <p class="text-md">x <span data-chat-form-target="submitCountDown" class="text-4xl"><%= @message_limit %></span></p>
                            </div>
                        </div>
                        <%= f.button type: :submit, data: { chat_form_target: "sendButton" }, class: "btn btn-primary d-inline-flex align-items-center gap-2 rounded-full" do %>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6" style="width: 1.5rem; height: 1.5rem;">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
                            </svg>
                        <% end %>
                    </div>
                </div>
            <% end %>
        </div>
    </div>

    <!-- チャット欄 -->
    <div class="relative bg-base-300">

        <!-- 録音ボタン -->
        <div class="fixed bottom-4 left-1/2 -translate-x-1/2 z-[9999] opacity-75 hover:opacity-90 active:opacity-100 duration-100 ">
            <!-- 開始 -->
            <button 
                data-action="click->transcription#start"
                data-transcription-target="recordButton"
                class="btn btn-primary rounded-full w-25 landscape:w-20 h-25 landscape:h-20"
            >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-10 landscape:size-8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3Z" />
                </svg>
            </button>

            <!-- 停止 -->
            <button 
                data-action="click->transcription#stop"
                data-transcription-target="stopButton"
                class="btn btn-secondary rounded-full w-25 landscape:w-20 h-25 landscape:h-20 hidden" 
                disabled
            >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-10 landscape:size-8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3Z" />
                </svg>
            </button>

            <!-- ローディング -->
            <div 
                data-transcription-target="loadButton"
                class="btn btn-secondary rounded-full w-25 landscape:w-20 h-25 landscape:h-20 opacity-95 hidden" 
                disabled
            >
                <span class="loading loading-spinner loading-md"></span>
            </div>

        </div>

        <div class="w-full max-w-xl mx-auto px-4 py-5 flex flex-col gap-0">
            <div id="chat_messages_container">
            </div>
        </div>

    </div>
</div>
<!-- フッターの内容変更 -->
<% provide(:footer_content) do %>
    <!-- 空欄 -->
<% end %>
