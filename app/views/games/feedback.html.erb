<!-- ヘッダーの内容変更 -->
<% if @history_mode == 1 %>
  <% provide(:history_record) do %>
    <div class="flex items-end gap-0 text-2xl opacity-75">
      <%= t(".page_title") %>
    </div>
  <% end %>
<% else %>
  <% provide(:page_name) do %>
    <div class="flex items-end gap-0 text-2xl opacity-75">
      <%= t(".page_title") %>
    </div>
  <% end %>
<% end %>

<div class="pt-10">
  <!-- コントローラー名を chat-feedback と定義 -->
  <div 
    data-controller="chat-feedback" 
    class ="flex flex-col w-full"
    >

    <div class="chat chat-start w-full mx-auto p-5 flex flex-col max-w-md landscape:max-w-5xl mx-auto gap-5"> 

      <!-- 画像比較 -->
      <div 
        data-chat-feedback-target="message" 
        class="chat-bubble hidden bg-base-100 flex flex-col w-full h-auto"
        >

        <p class="text-sm opacity-25"><%= t(".img_comparison") %></p>
        <div class="flex flex-col landscape:flex-row gap-4 landscape:gap-8 justify-center items-center m-4">
          <div class="flex flex-col gap-2">
            <p class="text-sm opacity-75 w-full"><%= t(".prompt") %></p>
            <div class="w-full landscape:w-[350px] h-full landscape:h-auto p-0.5">
              <img
                  id="theme-image-imgtag"
                  src="<%= @game.theme_image_url %>"
                  alt="お題イメージ"
                  class="w-full h-full landscape:h-auto object-cover object-left rounded-4xl">
            </div>
          </div>
          <div class="flex flex-col gap-2">
            <p class="text-sm opacity-75 w-full"><%= t(".generated_image") %></p>
            <div class="w-full landscape:w-[350px] h-full landscape:h-auto bg-primary p-0.5 rounded-4xl">
              <% if @game.generated_image.attached? %>
                <img src="<%= url_for(@game.generated_image) %>" alt="AIのイメージ" class="w-full h-full landscape:h-auto object-cover object-left aspect-[600/400] rounded-4xl">
              <% else %>
                <div class="w-full h-full landscape:h-auto object-cover object-right aspect-[600/400] bg-base-100 rounded-4xl"></div>
              <% end %>
            </div>
          </div>
        </div>
      </div>  

      <!-- 総評 -->
      <div  
        data-chat-feedback-target="message" 
        class="chat-bubble hidden bg-base-100 flex flex-col w-full h-auto"
        >
        <p class="text-xs opacity-25"><%= t(".general_review") %></p>
        <div class="ml-2">
          <div class="flex flex-col gap-0.5 my-1 opacity-75">
            <p class="pl-4 text-sm"><%= simple_format(@game.feedback["image_analysis"]) %></p>
          </div>
        </div>
      </div>     
      

      <!-- 文比較 -->
      <% if @game.feedback["proposals"].present? %>
        <% @game.feedback["proposals"].each_with_index do |proposal, idx| %>

          <div 
            data-controller="clipboard"
            data-clipboard-copy-message-value="<%= t('.copy') %>"
            data-chat-feedback-target="message" 
            class="chat-bubble hidden bg-base-100 flex flex-col items-center w-full h-auto"
            > 

            <div 
              data-clipboard-target="source" 
              class="content w-full h-auto pb-2 border-b-4 border-base-300"
              >

              <div class="ml-2 flex flex-col">
                  <!-- 上段：原文 -->
                  <p class="flex justify-start mt-2 text-xs text-base-content/25"><%= t(".your_description") %><span class="text-md font-bold"><%= idx+1 %></span></p>

                  <p class="ml-4 pt-1 pb-2 text-base font-mono opacity-75 border-b border-base-content/10">
                      <%= proposal["original_text"] %>
                  </p>
                  
                  <!-- 下段：修正後 -->
                  <p class="flex justify-start mt-2 text-xs text-base-content/25"><%= t(".proposal") %></p>
                  <p class="ml-4 pt-1 text-lg font-mono font-black text-success">
                      <%= proposal["rewritten_text"] %>
                  </p>
              </div>
              <p class="no-copy flex justify-end mt-2 text-xs text-base-content/25">
                  <%= t(".note") %>
              </p>
            </div>

            <button 
              data-clipboard-target="button" 
              data-action="clipboard#copy" 
              class="py-2"
              >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 opacity-50">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
              </svg>
            </button> 
          </div>

          <!-- フレーズ -->
          <div 
            data-controller="clipboard"
            data-clipboard-copy-message-value="<%= t('.copy') %>"
            data-chat-feedback-target="message" 
            class="chat-bubble hidden bg-base-100 flex flex-col items-center w-full h-auto"
            >
            <div 
              data-clipboard-target="source" 
              class="content w-full h-auto pb-2 border-b-4 border-base-300"
              >
              <p class="text-xs opacity-25"><%= t(".phrase") %><span class="text-md font-bold"><%= idx+1 %></span></p>
              <div class="ml-4">
                <p class="ml-4 text-lg"><%= proposal["bonus_phrase"]["phrase"] %></p>
                <p class="ml-4 mb-2 text-xs tracking-wide text-base-content/50"><%= proposal["bonus_phrase"]["meaning"] %></p>

                <p class="ml-4 border-b-2 border-base-content/10"></p>
                
                <p>・<%= proposal["bonus_phrase"]["example"] %></p>
              </div>
              <div class="ml-8">
                <div class="border-l-2 border-base-content/20 flex flex-col gap-0.5 my-1">
                  <!-- 翻訳は説明言語と学習言語が同じ場合、非表示にすること -->
                  <p class="pl-4 text-xs text-base-content/50"><%= proposal["bonus_phrase"]["example_translation"] %></p>
                </div>
              </div>
            </div>

            <button data-clipboard-target="button" data-action="clipboard#copy" class="py-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 opacity-50">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
              </svg>
            </button> 
          </div>
        <% end %>
      <% end %>


      <!-- 書き込み中表示 -->
      <div data-chat-feedback-target="message" class="chat-bubble whitespace-pre-wrap bg-base-100"><span class="loading loading-dots loading-sm"></span></div>
    </div>


    <div data-chat-feedback-target="button" class="hidden mb-20 flex justify-center gap-15 landscape:gap-25"> 
      <%=link_to t(".retry"), new_user_game_path(@game.user_id, image_url: @game.theme_image_url), method: :get, class: "btn btn-lg btn-neutral h-12 w-30 rounded-2xl" %>
      <%=button_to t(".end"), top_user_path(@game.user_id), method: :get, class: "btn btn-lg btn-neutral h-12 w-30 rounded-2xl" %>
    </div> 
  </div>
</div>


<!-- フッターの内容変更 -->
<% provide(:footer_content) do %>
  <!-- 空欄 -->
<% end %>