<!-- ヘッダーの内容変更 -->
<% provide(:sign_up) do %>
    <div class="flex items-end gap-0">
        <p class="text-2xl font-normal opacity-75">プレイ履歴</p>
    </div>
<% end %>

<%= form_with url: search_user_games_path(current_user), method: :get, local: true do |f| %>
  <%= f.text_field :query, value: @query %>
  <%= f.submit "検索" %>
<% end %>

<% if @games.present? %>
    <div class="flex flex-col max-w-sm landscape:max-w-3xl mx-auto pt-10 gap-5">
        <%= render partial: "shared/history_bar", collection: @games, as: :game %>
    </div>
<% else %>
    <div class="min-h-[calc(100vh-15rem)] flex flex-col justify-center items-center max-w-sm mx-auto mt-10">
        <div class="flex flex-col text-base-content/50 max-w-xs landscape:max-w-3xl mx-auto">
            <p class="text-lg">プレイ履歴がありません。</p>

        </div>
    </div>
<% end %>