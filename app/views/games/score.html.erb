<!-- ヘッダーの内容変更 -->
<% if @history_mode == 1 %>
  <!-- 履歴用のヘッダー -->
  <% provide(:history_record) do %>
      <div class="flex items-end gap-0 text-2xl opacity-75">
          <p>採点結果</p>
      </div>
  <% end %>
<% else %>
  <% provide(:in_game) do %>
      <div class="flex items-end gap-0 text-2xl opacity-75">
          <p>採点結果</p>
      </div>
  <% end %>
<% end %>


<% if @history_mode == 1 && authenticated? %>
  <!-- 履歴からの遷移はこちらを使う。パーシャルの処理を直書きしてるのは、@history_modeの受け渡しが容易なため。 -->
  <div data-controller="evaluation"
    class="flex flex-col justify-center items-center gap-15 py-10">
    <div class="flex flex-col text-center gap-5">
      <div class="flex flex-col text-2xl">
        <p>イメージ</p>
        <p>シンクロ率</p>
      </div>

      <!-- progress_controllerと紐付け -->
      <div 
        data-controller="progress"
        data-progress-overall-value="<%= @game.feedback["overall"] %>"
        class="radial-progress text-primary" 
        style="--value: 0; --size:12rem; 2rem;" 
        role="progressbar"
      >
        <div 
          id="checking_score_shown"
          data-progress-target="progressNum"
          class="text-5xl font-bold transition-opacity duration-500 opacity-0 hidden loading"><%= @game.feedback["overall"] %>
        </div>
      </div>
    </div>

    <div 
      data-evaluation-target="text"
      class="flex flex-col gap-3 transition-opacity duration-500 opacity-0"
    >
      <%= render_score_badge(@game.feedback["overall"]) %>
      
      <!-- Open the modal using ID.showModal() method -->
      <button class="flex flex-row justify-center items-center text-xs text-base-content/30 cursor-pointer" onclick="modal_01.showModal()" do>
        判定基準について
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
        </svg>
      </button>
      <dialog id="modal_01" class="modal">
        <div class="modal-box">
          <h3 class="text-lg font-bold">Hello!</h3>
          <p class="py-4">Press ESC key or click outside to close</p>
        </div>
        <form method="dialog" class="modal-backdrop">
          <button>close</button>
        </form>
      </dialog>
    </div>



    <div class="flex justify-center">
      <%=button_to "つぎへ", feedback_user_game_path(@game.user_id, @game),
        params: { history_mode: @history_mode },
        method: :get, 
        class: "btn btn-lg btn-primary text-primary-content w-70 h-12 rounded-2xl", 
        disabled: false %>
    </div>
    
  </div>

<% else %>
  <!-- ゲーム中の処理はこちらを使う。 -->
  <div 
    data-controller="score-polling"
    data-score-polling-url-value="<%= check_score_user_game_path(@game.user_id, @game) %>"
    data-score-polling-max-attempts-value="60"
    data-score-polling-interval-value="2000"
  >
    <div id="resulting_score">
        <div class="splash-overlay">
          <div class="hero-content text-center">
            <div class="grid place-items-center text-center w-full">
              <p class="text-2xl">
                採点中
              </p>
              <div class="text-xm my-5">
                <span class="loading loading-spinner loading-md"></span>
              </div>
            </div>
          </div>
        </div>
    </div>
  </div>
<% end %>


<!-- フッターの内容変更 -->
<% provide(:footer_content) do %>
    <!-- 空欄 -->
<% end %>