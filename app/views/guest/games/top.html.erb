<div class="min-h-[calc(100vh-15rem)] hero mt-10">
  <div class="hero-content flex flex-col items-center w-full">
    <div class="grid flex flex-col place-items-center text-center w-full">
      <!-- タイトルロゴ -->
      <div 
                class="bg-base-content w-70 h-16" 
                style="
                  -webkit-mask-image: url('<%= asset_path("DT_title.png") %>');
                  mask-image: url('<%= asset_path("DT_title.png") %>');
                  -webkit-mask-size: contain;
                  mask-size: contain;
                  -webkit-mask-repeat: no-repeat;
                  mask-repeat: no-repeat;
                  -webkit-mask-position: center;
                  mask-position: center;
                "
              ></div>
      <p class="my-6">
        <%= t('.catchphrase_html') %>
      </p>

      <div class="flex flex-col gap-5 mb-10">
        <p class="text-sm">
          <%= t('.description_part1_html') %>
        </p>
        <p class="text-sm">
          <%= t('.description_part2_html') %>
        </p>
      </div>
      <div class="flex flex-col gap-10">
        <div class="flex flex-row justify-center gap-5">
          <%=button_to t('common.signup'), registrations_new_path, method: :get, class: "btn btn-md btn-primary w-30 h-10 rounded-2xl" %>
          <%=button_to t('common.login'), new_session_path, method: :get, class: "btn btn-md btn-primary w-30 h-10 rounded-2xl" %>
        </div>
        <%=button_to t('common.start_game'), new_guest_game_path, method: :get, class: "btn btn-lg btn-primary w-70 h-12 rounded-2xl" %>
      </div>
    </div>

    <!-- 遊び方モーダルの内容 -->
    <div data-controller="splash-modal" >
      <dialog 
        data-controller="swipe-modal"
        data-swipe-modal-next-message-value="<%= t('common.next_page') %>"
        data-swipe-modal-close-message-value="<%= t('common.close_page') %>"
        data-splash-modal-target="dialog" 
        id="swipe_modal" 
        class="modal"
        >
        <div class="modal-box py-3 max-w-sm rounded-2xl overflow-hidden bg-base-100 flex flex-col items-center">
          <div class="text-3xl"><%= t("common.how_to_play") %></div>
          <div 
            class="carousel focus:outline-none w-full snap-x snap-mandatory overflow-x-auto scroll-smooth"
            data-swipe-modal-target="carousel"
            data-action="scroll->swipe-modal#handleScroll"
          >
            <div id="slide1" class="carousel-item w-full flex-col">
              <%= render "shared/splash_modal/modal_01" %>
            </div>
            <div id="slide2" class="carousel-item w-full flex-col">
              <%= render "shared/splash_modal/modal_02" %>
            </div>
            <div id="slide3" class="carousel-item w-full flex-col">
              <%= render "shared/splash_modal/modal_03" %>
            </div>
          </div>
            
          <div class="flex gap-1.5 py-2">
            <span class="h-2.5 w-2.5 rounded-full" data-swipe-modal-target="dot"></span>
            <span class="h-2.5 w-2.5 rounded-full" data-swipe-modal-target="dot"></span>
            <span class="h-2.5 w-2.5 rounded-full" data-swipe-modal-target="dot"></span>
          </div>
              
          <button 
            class="btn btn-sm px-6 btn-primary w-70 h-12 rounded-2xl text-lg"
            data-swipe-modal-target="actionBtn"
            data-action="click->swipe-modal#nextOrClose"
          ><%= t('common.next_page') %></button>
        </div>


        <!-- 背景をクリックしても閉じられるようにする設定（不要なら削除OK） -->
        <form method="dialog" class="modal-backdrop">
          <button>close</button>
        </form>
      </dialog>

    </div>
  </div>
</div>
