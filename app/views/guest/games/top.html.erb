<div class="min-h-[calc(100vh-15rem)] hero mt-10">
  <div class="hero-content flex flex-col items-center w-full">
    <div class="grid flex flex-col place-items-center text-center w-full">
      <!-- タイトルロゴ -->
      <div 
                class="bg-base-content w-70 h-16" 
                style="
                  -webkit-mask-image: url('<%= asset_path("DT_title.png") %>');
                  mask-image: url('<%= asset_path("DT_title.png") %>');
                  -webkit-mask-size: contain;
                  mask-size: contain;
                  -webkit-mask-repeat: no-repeat;
                  mask-repeat: no-repeat;
                  -webkit-mask-position: center;
                  mask-position: center;
                "
              ></div>
      <p class="my-6">
        <%= t('.catchphrase_html', locale_in_game: render_locale_name(cookies[:job_param])) %>
      </p>

      <div class="flex flex-col gap-5 mb-10">
        <p class="text-sm">
          <%= t('.description_part1_html', locale_in_game: render_locale_name(cookies[:job_param])) %>
        </p>
        <p class="text-sm">
          <%= t('.description_part2_html') %>
        </p>
      </div>
      <div class="flex flex-col gap-10 w-[300]">
        <div class="flex flex-row justify-center gap-14">
          <%=button_to t('common.signup'), registrations_new_path, method: :get, class: "btn btn-md btn-primary w-30 h-10 rounded-2xl" %>
          <%=button_to t('common.login'), new_session_path, method: :get, class: "btn btn-md btn-primary w-30 h-10 rounded-2xl" %>
        </div>
        <%=button_to t('common.start_game'), new_guest_game_path, method: :get, class: "btn btn-lg btn-primary w-full h-12 rounded-2xl" %>
      </div>
    </div>


    <div class="flex flex-col items-center border-y-2 border-base-content/10 py-3">
      <!-- ゲーム内言語設定 -->
      <div class="grid grid-cols-[150px_1fr] flex flex-row items-center">
        <div class="flex flex-row justify-self-end items-center gap-2">
            <%=t("common.locale_in_game")%>
        </div>
        <div class="dropdown w-30 ml-5">
          <!-- 言語リスト -->
          <% langs_in_game = [ 
            { locale: 'ja', text: t('language.Japanese') }, 
            { locale: 'en', text: t('language.English') }, 
          ] %>

          <!-- ボタン（表示部分） -->
          <div tabindex="0" role="button" class="btn-sm select m-1">
            <% current_lang_in_game = langs_in_game.find { |lang| lang[:locale] == cookies[:job_param].to_s } %>
            <%= current_lang_in_game ? current_lang_in_game[:text] : t(".language.Japanese") %>
          </div>

          <!-- メニュー一覧（クリック領域を100%確保） -->
          <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-[1] w-52 p-2 shadow">
            <% langs_in_game.each do |lang| %>
              <li>
                <%= link_to update_locale_in_game_locale_path(job_param: lang[:locale]), class: "w-full h-full block" do %>
                  <span class="opacity-50 mr-5"><%= lang[:locale].upcase %></span> <%= lang[:text] %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>

      <!-- 難易度 -->
      <div class="grid grid-cols-[150px_1fr] flex flex-row items-center">
        <div class="flex flex-row justify-self-end items-center gap-2">
            <%=t("common.difficulty_level")%>
        </div>
        <div class="dropdown dropdown-top w-30 ml-5">
          <!-- 言語リスト -->
          <% mode_options = [ 
            { mode: 0, text: t('enums.games.mode.beginner') }, 
            { mode: 2, text: t('enums.games.mode.standard') }, 
          ] %>

          <!-- ボタン（表示部分） -->
          <div tabindex="0" role="button" class="btn-sm select m-1">
            <% current_mode = mode_options.find { |mode| mode[:mode] == cookies[:mode].to_i } %>
            <%= current_mode ? current_mode[:text] : t("enums.games.mode.beginner") %>
          </div>

          <!-- メニュー一覧（クリック領域を100%確保） -->
          <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-[1] w-52 p-2 shadow">
            <% mode_options.each do |mode| %>
              <li> 
                <%= link_to update_game_mode_locale_path(mode: mode[:mode]), class: "w-full h-full block" do %>
                  <%= mode[:text] %>
                <% end %>
            <% end %>
          </ul>
        </div>

      <div><!-- gridの配置調整に使用 --></div>

      <button class="flex flex-row justify-center items-center text-xs text-base-content/30 cursor-pointer ml-5" onclick="modal_01.showModal()" do>
        <%= t('common.info_difficulty_level') %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
        </svg>
      </button>
      <dialog id="modal_01" class="modal">
        <div class="modal-box w-[340] landscape:w-auto h-[660] rounded-2xl">
          <%= render partial: "shared/info_difficulty_level" %>
        </div>
        <form method="dialog" class="modal-backdrop">
          <button>close</button>
        </form>
      </dialog>


      </div>
    </div>


    <!-- 遊び方モーダルの内容 -->
    <div data-controller="splash-modal" >
      <dialog 
        data-controller="swipe-modal"
        data-swipe-modal-next-message-value="<%= t('common.next_page') %>"
        data-swipe-modal-close-message-value="<%= t('common.close_page') %>"
        data-splash-modal-target="dialog" 
        id="swipe_modal" 
        class="modal"
        >
        <div class="modal-box py-3 max-w-sm rounded-2xl overflow-hidden bg-base-100 flex flex-col items-center">
          <div class="text-3xl"><%= t("common.how_to_play") %></div>
          <div 
            class="carousel focus:outline-none w-full snap-x snap-mandatory overflow-x-auto scroll-smooth"
            data-swipe-modal-target="carousel"
            data-action="scroll->swipe-modal#handleScroll"
          >
            <div id="slide1" class="carousel-item w-full flex-col">
              <%= render "shared/splash_modal/modal_01" %>
            </div>
            <div id="slide2" class="carousel-item w-full flex-col">
              <%= render "shared/splash_modal/modal_02" %>
            </div>
            <div id="slide3" class="carousel-item w-full flex-col">
              <%= render "shared/splash_modal/modal_03" %>
            </div>
          </div>
            
          <div class="flex gap-1.5 py-2">
            <span class="h-2.5 w-2.5 rounded-full" data-swipe-modal-target="dot"></span>
            <span class="h-2.5 w-2.5 rounded-full" data-swipe-modal-target="dot"></span>
            <span class="h-2.5 w-2.5 rounded-full" data-swipe-modal-target="dot"></span>
          </div>
              
          <button 
            class="btn btn-sm px-6 btn-primary w-70 h-12 rounded-2xl text-lg"
            data-swipe-modal-target="actionBtn"
            data-action="click->swipe-modal#nextOrClose"
          ><%= t('common.next_page') %></button>
        </div>


        <!-- 背景をクリックしても閉じられるようにする設定（不要なら削除OK） -->
        <form method="dialog" class="modal-backdrop">
          <button>close</button>
        </form>
      </dialog>

    </div>
  </div>
</div>
