<!--ログイン分岐-->
<% if authenticated? %>
    <%=button_to "採点", score_game_path(game),
        method: :get, 
        class: "btn btn-lg btn-primary text-primary-content w-70 h-12 rounded-2xl", 
        disabled: false, 
        data: { collapsible_image_target: "submitButton" } %>
<% else %>
    <%=button_to "採点", score_guest_game_path(game),
        method: :get, 
        class: "btn btn-lg btn-primary text-primary-content w-70 h-12 rounded-2xl", 
        disabled: false, 
        data: { collapsible_image_target: "submitButton" } %>
<% end %>