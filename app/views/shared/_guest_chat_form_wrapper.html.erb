<%= form_with(
    url: guest_game_path, model: @game,
    data: { 
        controller: "guest--chat-form", 
        guest__chat_form_limit_value: @message_limit, 
        action: "
                submit->guest--chat-form#validateForm 
                keydown->guest--chat-form#handleKeydown 
                turbo:submit-end->guest--chat-form#clear
                " 
    }) do |f| %>

    <div class="flex gap-2 items-end">
        <%= f.text_area :description, 
            id: "transcript_id",
            data: { 
                transcription_target: "transcript",
                guest__chat_form_target: "textarea", 
                action: "input->guest--chat-form#resize"
            },
            rows: 1,
            class: "textarea textarea-bordered w-full resize-none py-2 min-h-[40px] h-[40px]", 
            placeholder: t('common.chat_placeholder') %>
        <div class="tooltip tooltip-open tooltip-primary">
            <div class="tooltip-content bg-transparent shadow-none">
                <div class="text-sm flex flex-col justify-center items-center text-primary font-bold">
                    <p class="text-md">x <span data-guest--chat-form-target="submitCountDown" class="text-4xl"><%= @message_limit %></span></p>
                </div>
            </div>
            <%= f.button type: :submit, data: { guest__chat_form_target: "sendButton" }, class: "btn btn-primary d-inline-flex align-items-center gap-2 rounded-full" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6" style="width: 1.5rem; height: 1.5rem;">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
                </svg>
            <% end %>
        </div>
    </div>
<% end %>