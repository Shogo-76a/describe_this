<!-- 両端にホーム用ボタン(レコード削除機能なし) と テーマボタン があるヘッダー -->
<header class="flex justify-between items-center navbar bg-base-100 text-base-content p-2">
    <%= button_to user_games_path(current_user), method: :get, class: "inline-block" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
    <% end %>
    <%= yield :history_record %>
    <%= render 'shared/theme_color_tab', theme_name: 'light' %>
</header>