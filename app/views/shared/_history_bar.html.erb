<div class="flex flex-col w-full h-auto bg-base-100 rounded-2xl p-5">
    <div class="flex flex-row gap-5">
        <img src="<%= url_for(game.generated_image) %>" alt="レコードイメージ" class="w-20 h-20 mask mask-circle object-cover">
        <div class="flex flex-col justify-center items-start gap-2">
            <p class="text-lg"><%= game.feedback["title_for_history"] %></p>
            <p class="text-xs text-base-content/50"><%= game.created_at %></p>
        </div>
    </div>
</div>