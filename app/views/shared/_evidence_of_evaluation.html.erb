<div class="prose prose-sm sm:prose-base max-w-none">
  <h2><%= t('.title') %></h2>

  <% %i[perfect amazing great good okay needs_work].each do |level| %>
    <h3><%= t(".#{level}.label") %></h3>
    <ul>
      <li><strong><%= t('.labels.score') %></strong> <%= t(".#{level}.score") %></li>
      <li><strong><%= t('.labels.rationale') %></strong> <%= t(".#{level}.description") %></li>
    </ul>
  <% end %>
</div>