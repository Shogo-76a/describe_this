
<!-- ページごとに書き換わるエリア -->
<% if content_for?(:sign_up) %>
    <%= render partial: "shared/header_partial/sign_up"%>

<% elsif content_for?(:in_game) %>
    <%= render partial: "shared/header_partial/in_game"%>

<% elsif content_for?(:document) %>
    <%= render partial: "shared/header_partial/document"%>

<% elsif content_for?(:history_record) %>
    <%= render partial: "shared/header_partial/history_record"%>

<% elsif content_for?(:custom) %>
    <!-- 完全カスタマイズしたいときのヘッダー -->
    <%= yield :custom %>

<% else %>
    <!-- デフォルト表示 -->
    <%= render partial: "shared/header_partial/default"%>
<% end %>

