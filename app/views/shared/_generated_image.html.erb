<% if game.generated_image.attached? %>
    <img id="checking_image_shown" src="<%= url_for(game.generated_image) %>" alt="ローディング..." class="w-full h-full landscape:h-auto object-cover object-left aspect-[600/400] rounded-4xl">
<% else %>
    <div class="w-full h-full landscape:h-auto object-cover object-right aspect-[600/400] bg-base-100 rounded-4xl"></div>
<% end %>
