<!-- ヘッダーの内容変更 -->
<% provide(:sign_up) do %>
    <div class="flex items-end gap-0">
        <p class="text-2xl font-normal opacity-75">パスワードリセット</p>
    </div>
<% end %>

<div class="min-h-[calc(100vh-15rem)] flex flex-col justify-center items-center max-w-sm mx-auto mt-10">
  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg inline-block" id="alert"><%= alert %></p>
  <% end %>

  <%= form_with url: password_path(params[:token]), method: :put, class: "flex flex-col items-center justify-center gap-3" do |form| %>
    <div class="w-full">
      <%= form.label :password, "新しいパスワード" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "mt-1 items-center justify-center input input-bordered rounded-full w-full" %>
    </div>

    <div class="w-full">
      <%= form.label :password_confirmation, "新しいパスワード（確認用）" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "mt-1 items-center justify-center input input-bordered rounded-full w-full" %>
    </div>

    <%= form.submit "新しいパスワードを登録する", class: "mt-10 btn btn-primary btn-text-primary w-70 rounded-full" %>

  <% end %>
</div>
