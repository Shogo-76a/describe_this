<!-- ヘッダーの内容変更 -->
<% provide(:document) do %>
    <div class="flex">
        <div class="flex flex-row gap-2 justify-center items-center text-2xl font-normal opacity-75">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
            </svg>
            <p><%= t(".page_title") %></p>
        </div>
    </div>
<% end %>

<div class="prose py-10 max-w-xs landscape:max-w-3xl mx-auto">
  <p><%= t(".intro") %></p>
  <%# 1. 取得する情報 %>
  <section>
    <h3><%= t(".sections.section1.title") %></h3>
    <p><%= t(".sections.section1.description") %></p>
    <ul>
      <li>
        <strong><%= t(".sections.section1.items.account") %></strong>: <%= t(".sections.section1.items.account_desc") %>
      </li>
      <li>
        <strong><%= t(".sections.section1.items.user_input") %></strong>: <%= t(".sections.section1.items.user_input_desc") %>
      </li>
      <li>
        <strong><%= t(".sections.section1.items.learning_history") %></strong>: <%= t(".sections.section1.items.learning_history_desc") %>
      </li>
      <li>
        <strong><%= t(".sections.section1.items.technical_info") %></strong>: <%= t(".sections.section1.items.technical_info_desc") %>
      </li>
    </ul>
  </section>

  <%# 2. 利用目的 %>
  <section>
    <h3><%= t(".sections.section2.title") %></h3>
    <p><%= t(".sections.section2.description") %></p>
    <ul>
      <% t(".sections.section2.items").each do |item| %>
        <li><%= item %></li>
      <% end %>
    </ul>
  </section>

  <%# 3. 外部サービスの利用 %>
  <section>
    <h3><%= t(".sections.section3.title") %></h3>
    <ol>
      <% t(".sections.section3.items").each do |item| %>
        <li><%= item %></li>
      <% end %>
    </ol>
  </section>

  <%# 4〜8. 単一テキストセクション %>
  <% %i[section4 section5 section6 section7 section8].each do |section| %>
    <section>
      <h3><%= t(".sections.#{section}.title") %></h3>
      <p><%= t(".sections.#{section}.content") %></p>
    </section>
  <% end %>

  <%# 9. お問い合わせ %>
  <section>
    <h3><%= t(".sections.section9.title") %></h3>
    <p><%= t(".sections.section9.description") %></p>
    <ul>
      <li><%= t(".sections.section9.contact_label", email: "describe.this.contact@gmail.com") %></li>
    </ul>
  </section>

  <p class="text-base-content/50">
    <%= t(".last_updated", date: (I18n.locale == :ja ? "2026年8月2日" : "August 2, 2026")) %>
  </p>
</div>


<!-- フッターの内容変更 -->
<% provide(:footer_content) do %>
    <!-- 空欄 -->
<% end %>