<div data-controller="transcription">
  <div class="controls">
    <button type="button"
            data-action="click->transcription#start"
            data-transcription-target="recordButton"
            class="btn btn-primary">
      録音開始
    </button>

    <button type="button"
            data-action="click->transcription#stop"
            data-transcription-target="stopButton"
            class="btn btn-danger"
            disabled>
      停止
    </button>
  </div>

  <p data-transcription-target="status">準備中…</p>

  <div class="result">
    <h3>文字起こし</h3>
    <pre data-transcription-target="transcript" style="white-space: pre-wrap;"></pre>
  </div>
</div>